# Copy this file to ".env" (which is git-ignored) and fill in real values.
# DotNetEnv loads these into environment variables at startup; the ASP.NET Core
# configuration system then exposes them (double underscore => configuration section
# separator, e.g. Jwt__SigningKey => configuration key "Jwt:SigningKey").

# Secret used to sign and validate development JWTs. Must be at least 32 characters.
Jwt__SigningKey=change-me-to-a-long-random-string-at-least-32-chars

# Optional: override the ASP.NET Core environment.
# ASPNETCORE_ENVIRONMENT=Development
