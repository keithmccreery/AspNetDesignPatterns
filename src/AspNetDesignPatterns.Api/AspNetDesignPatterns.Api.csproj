<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AspNetDesignPatterns.Api</RootNamespace>
    <UserSecretsId>aspnet-design-patterns-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal types (and the generated Program class) to the test project. -->
    <InternalsVisibleTo Include="AspNetDesignPatterns.Api.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" /><!-- NSubstitute -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- The one fluent sink in an otherwise declarative (appsettings.json) Serilog config:
         it shares KAM.Common.Telemetry.TelemetrySettings.OtlpEndpoint with the trace/metric
         exporters, so one config value drives all three signals to the same collector. -->
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <!-- DependencyInjection/, Auth/, Results/, etc. live here: see src/KAM.Common/README.md
         for why they're a separate, independently reusable project. -->
    <ProjectReference Include="..\KAM.Common\KAM.Common.csproj" />
  </ItemGroup>

</Project>
