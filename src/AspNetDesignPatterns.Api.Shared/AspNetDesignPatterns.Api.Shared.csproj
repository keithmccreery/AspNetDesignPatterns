<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not ".Shared": this project holds two top-level namespaces, DependencyInjection/ and
         Shared/, both rooted at AspNetDesignPatterns.Api (see each folder's README for why they
         are siblings rather than one nested under the other). RootNamespace only affects
         designer-generated file namespaces here (everything else declares its own), but keeping
         it at the real common root matches dotnet_style_namespace_match_folder. -->
    <RootNamespace>AspNetDesignPatterns.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A class library (not Microsoft.NET.Sdk.Web) that uses ASP.NET Core types needs this
         explicitly: the Web SDK pulls it in implicitly, a plain class library does not. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept separate from AspNetDesignPatterns.Api on purpose: everything under DependencyInjection/
         and Shared/ is meant to be extractable to its own package later, so it never references
         the host project or a feature. See DependencyInjection/README.md and Shared/README.md.

         Naming note: if/when this is extracted to its own repo, it becomes Skimutt.Shared. -->
    <InternalsVisibleTo Include="AspNetDesignPatterns.Api.Shared.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" /><!-- NSubstitute -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
