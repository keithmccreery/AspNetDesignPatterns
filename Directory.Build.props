<Project>

  <!--
    Shared MSBuild settings applied to every project in the repo.
    Individual projects can override any of these.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Treat compiler warnings as errors so the sample stays clean, but keep analyzer
         diagnostics (CAxxxx and the third-party suites below) advisory rather than build
         breakers. Rules are promoted to warning/error individually in .editorconfig as the
         codebase adopts them. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Analyzer rules intentionally relaxed for a readable sample:
        CA1716  'Shared'/'Error' collide with VB keywords - irrelevant to a C# app.
        CA1014  CLSCompliant assembly attribute - only meaningful for shipped libraries.
        CA1848  high-ceremony LoggerMessage source-gen delegates - clarity wins here.
        CA1873  paired with CA1848 (guarding log-argument evaluation).
    -->
    <NoWarn>$(NoWarn);CA1716;CA1014;CA1848;CA1873</NoWarn>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc comment for a publicly visible type/member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Nerdbank.GitVersioning, applied to every project (build-time only — PrivateAssets="all").
    Computes AssemblyVersion/AssemblyInformationalVersion from version.json + git height/commit;
    no version needs to change here or in any csproj. TelemetryExtensions.ResolveServiceVersion
    reads exactly the InformationalVersion this produces.
  -->
  <ItemGroup Label="Versioning">
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Analyzer suites, applied to every project. PrivateAssets="all" keeps them from flowing
    to consumers; IncludeAssets excludes the runtime so only the analyzer + build assets load.
  -->
  <ItemGroup Label="Analyzers">
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.Structs">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AsyncFixer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="IDisposableAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared StyleCop configuration (headers off, etc.). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

</Project>
